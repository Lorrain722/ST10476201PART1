/* Reset browser defaults */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Default body styles */
body {
  font-family: Arial, sans-serif;
  font-size: 16px;
  line-height: 1.7;
  letter-spacing: 0.5px;
  background-color: #f5eee6; /* cream background */
  color: #3e2723; /* dark brown text */
}

/* Header */
header {
  background-color: #6f4e37; /* coffee brown */
  color: white;
  text-align: center;
  padding: 25px 20px;
}
header img {
  width: 110px;
  height: 110px;
  object-fit: cover;
  border-radius: 50%;
  display: block;
  margin: 0 auto 15px;
}
header h1 {
  font-size: 32px;
  margin: 5px;
}
header p {
  font-size: 17px;
}

/* Navigation */
nav {
  background-color: #3e2723;
  padding: 15px;
}
nav ul {
  list-style: none;
  display: flex;
  justify-content: center;
  gap: 30px;
  flex-wrap: wrap;
}
nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}
nav a:hover {
  color: #d7b899;
}

/* Sections */
section {
  background-color: white;
  padding: 25px;
  margin-bottom: 25px;
  border-radius: 12px;
  box-shadow: 0 3px 10px rgba(0,0,0,0.15);
}
h2 {
  color: #6f4e37;
  border-bottom: 2px solid #c8a27a;
  padding-bottom: 10px;
}
h3 {
  color: #6f4e37;
}

/* Buttons */
.button, button {
  display: inline-block;
  background-color: #6f4e37;
  color: white;
  padding: 12px 25px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: bold;
  margin-top: 10px;
  border: none;
  cursor: pointer;
}
.button:hover, button:hover {
  background-color: #3e2723;
}

/* Cards & Services */
.cards, .services-container, .values {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
  gap: 20px;
  margin-top: 20px;
}
.card, .service-card, .value-card {
  background-color: #f8f1ea;
  border: 1px solid #d8c5b5;
  border-radius: 10px;
  padding: 20px;
  text-align: center;
}
.card-image, .service-image {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 10px;
}
.price {
  color: #6f4e37;
  font-weight: bold;
  font-size: 18px;
}

/* Forms */
form {
  margin-top: 20px;
}
label {
  display: block;
  margin-top: 15px;
  margin-bottom: 5px;
  font-weight: bold;
  color: #6f4e37;
}
input, select, textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #c8a27a;
  border-radius: 6px;
  font-size: 15px;
}
textarea {
  height: 130px;
  resize: vertical;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border: 2px solid #6f4e37;
}

/* Tables */
table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 20px;
}
th {
  background-color: #6f4e37;
  color: white;
  padding: 14px;
  text-align: left;
}
td {
  padding: 13px;
  border: 1px solid #d8c5b5;
}
tr:nth-child(even) {
  background-color: #f5eee6;
}

/* Images */
.welcome-image, .about-image, .bottom-image, .enquiry-image {
  width: 100%;
  max-width: 800px;
  height: auto;
  display: block;
  margin: 20px auto;
  border-radius: 12px;
}

/* Lists */
.why-us, .highlights, .benefits {
  line-height: 2;
  padding-left: 25px;
}

/* Footer */
footer {
  background-color: #3e2723;
  color: white;
  text-align: center;
  padding: 20px;
}
footer p {
  margin: 5px;
}

/* Responsive Design */
@media (max-width: 900px) {
  body { font-size: 15px; }
  header h1 { font-size: 28px; }
}
@media (max-width: 700px) {
  nav ul {
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }
  .services-container {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 500px) {
  body { font-size: 14px; }
  header h1 { font-size: 22px; }
  .welcome-image { height: 200px; }
  .buttons { flex-direction: column; }
  button { width: 100%; }
  table, tr, td, th {
    display: block;
    width: 100%;
  }
}
